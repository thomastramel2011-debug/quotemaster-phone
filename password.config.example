# One shared username and one shared password for every Family Termite tech.
# There are no separate tech accounts. This example is not the real sign-in.
# Copy this file to password.config. That copy stays on your computer.
# It is not uploaded with the site.
#
# 1. Replace both values below.
# 2. The password needs at least 12 characters.
# 3. Do not reuse a password that was already published in this repository.
# 4. Save the file.
# 5. Run: node _build/build.js
# 6. Commit index.html and push it to main.
#
# Spaces at the start or end of either value are removed.

QUOTEMASTER_USERNAME=REPLACE_WITH_THE_SHARED_USERNAME
QUOTEMASTER_PASSWORD=REPLACE_WITH_A_LONG_PASSWORD
